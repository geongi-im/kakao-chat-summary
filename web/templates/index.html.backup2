{% extends "base.html" %}
{% block title %}채팅방 목록 · 카카오채팅 요약{% endblock %}

{% block content %}
<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">채팅방 목록</h1>
    <p class="text-sm text-gray-400 mt-0.5">
      {% if room_stats %}{{ room_stats|length }}개의 채팅방{% else %}아직 채팅방이 없습니다{% endif %}
    </p>
  </div>
  <button onclick="document.getElementById('add-room-modal').classList.remove('hidden')"
    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold text-gray-900 shadow-sm
           hover:shadow-md active:scale-95 transition-all" style="background:#FEE500;">
    + 새 채팅방
  </button>
</div>

<!-- Room Grid -->
{% if room_stats %}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
  {% for item in room_stats %}
  {% set room = item.room %}
  {% set stats = item.stats %}
  {% set total_msg = stats.get('total_messages', 0) if stats else 0 %}
  {% set senders = stats.get('unique_senders', 0) if stats else 0 %}
  {% set first_d = stats.get('first_date') if stats else None %}
  {% set last_d = stats.get('last_date') if stats else None %}

  <article class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm
                  hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group">
    <div class="h-1" style="background: linear-gradient(90deg, #FEE500, #FCD34D);"></div>
    <div class="p-5">
      <div class="flex items-start justify-between gap-2 mb-4">
        <h2 class="font-semibold text-gray-900 text-base leading-snug truncate flex-1 min-w-0">{{ room.name }}</h2>
        <button onclick="event.stopPropagation(); deleteRoom({{ room.id }}, '{{ room.name | replace("'", "\\'") }}')"
          class="opacity-0 group-hover:opacity-100 w-7 h-7 rounded-lg flex items-center justify-center
                 text-gray-300 hover:text-red-400 hover:bg-red-50 transition-all flex-shrink-0"
          title="채팅방 삭제">✕</button>
      </div>

      {% if first_d and last_d %}
      <div class="flex items-center gap-2 mb-4">
        <div class="flex-1 bg-gray-50 rounded-xl px-3 py-2.5 text-center">
          <p class="text-[10px] text-gray-400 mb-0.5">시작</p>
          <p class="text-sm font-semibold text-gray-800 tabular-nums">{{ first_d }}</p>
        </div>
        <span class="text-gray-300 text-sm">→</span>
        <div class="flex-1 bg-gray-50 rounded-xl px-3 py-2.5 text-center">
          <p class="text-[10px] text-gray-400 mb-0.5">최근</p>
          <p class="text-sm font-semibold text-gray-800 tabular-nums">{{ last_d }}</p>
        </div>
      </div>
      {% else %}
      <div class="mb-4 h-14"></div>
      {% endif %}

      <a href="/rooms/{{ room.id }}"
        class="w-full flex items-center justify-between px-3 py-2 bg-gray-50 hover:bg-yellow-50 rounded-xl
               text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
        <span>채팅방 보기</span>
        <span>→</span>
      </a>
    </div>
  </article>
  {% endfor %}
</div>

{% else %}
<div class="text-center py-20 mb-8 bg-white rounded-2xl border-2 border-dashed border-gray-200">
  <div class="text-6xl mb-4">💬</div>
  <h3 class="text-lg font-semibold text-gray-700 mb-2">아직 채팅방이 없습니다</h3>
  <p class="text-sm text-gray-400 mb-6">카카오톡에서 대화를 내보낸 후 파일을 업로드하세요</p>
  <button onclick="document.getElementById('add-room-modal').classList.remove('hidden')"
    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-900 shadow-sm"
    style="background:#FEE500;">
    + 새 채팅방 추가
  </button>
</div>
{% endif %}

<!-- File Upload Section -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
    <span class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center">📤</span>
    <div>
      <h2 class="font-semibold text-gray-900 text-sm">대화 파일 업로드</h2>
      <p class="text-xs text-gray-400">카카오톡 내보내기(.txt) 파일 업로드</p>
    </div>
  </div>
  <div class="p-6">
    <form id="upload-form" hx-post="/api/upload" hx-encoding="multipart/form-data">
      <input type="hidden" name="create_room" value="false">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">채팅방 선택</label>
          {% if room_stats %}
          <select name="room_name" required
            class="w-full border border-gray-200 bg-gray-50 rounded-xl px-3.5 py-2.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-yellow-300 focus:bg-white transition-colors">
            <option value="">채팅방을 선택하세요...</option>
            {% for item in room_stats %}
            <option value="{{ item.room.name }}">{{ item.room.name }}</option>
            {% endfor %}
          </select>
          {% else %}
          <div class="w-full border border-dashed border-gray-200 bg-gray-50 rounded-xl px-3.5 py-2.5 text-sm text-gray-400">
            채팅방이 없습니다. 먼저 채팅방을 만드세요.
          </div>
          <input type="hidden" name="room_name" value="">
          {% endif %}
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">카카오톡 내보내기 파일</label>
          <input name="file" type="file" accept=".txt" required
            class="w-full text-sm text-gray-600 cursor-pointer
                   file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0
                   file:text-xs file:font-semibold file:bg-yellow-50 file:text-gray-700 hover:file:bg-yellow-100">
          <p class="text-xs text-gray-400 mt-1.5">.txt 파일만 지원합니다</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <button type="submit" {% if not room_stats %}disabled{% endif %}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-900 shadow-sm
                 hover:shadow-md active:scale-95 transition-all
                 {% if not room_stats %}opacity-40 cursor-not-allowed{% endif %}"
          style="background:#FEE500;">
          업로드
        </button>
        <span class="htmx-indicator flex items-center gap-2 text-sm text-gray-400">
          <span class="w-4 h-4 border-2 border-yellow-300 border-t-yellow-500 rounded-full spin"></span>
          처리 중...
        </span>
      </div>
    </form>
    <div id="upload-result" class="mt-4"></div>
  </div>
</div>

<!-- Add Room Modal -->
<div id="add-room-modal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background:rgba(0,0,0,.45);"
     onclick="if(event.target===this) this.classList.add('hidden')">
  <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-sm" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-5">
      <h3 class="font-bold text-gray-900 text-lg">새 채팅방 추가</h3>
      <button onclick="document.getElementById('add-room-modal').classList.add('hidden')"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:bg-gray-100">×</button>
    </div>
    <form id="create-room-form"
          hx-post="/api/rooms"
          hx-swap="none"
          hx-on::after-request="onRoomCreated(event)">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5">채팅방 이름</label>
      <input name="name" type="text" placeholder="예: 개발팀 단톡"
        class="w-full border border-gray-200 bg-gray-50 rounded-xl px-4 py-3 text-sm mb-4
               focus:outline-none focus:ring-2 focus:ring-yellow-300 focus:bg-white"
        required autofocus>
      <div class="flex gap-2.5">
        <button type="button"
          onclick="document.getElementById('add-room-modal').classList.add('hidden')"
          class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-medium rounded-xl hover:bg-gray-50">
          취소
        </button>
        <button type="submit"
          class="flex-1 py-2.5 text-gray-900 text-sm font-semibold rounded-xl shadow-sm active:scale-95 transition-all"
          style="background:#FEE500;">
          만들기
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  async function deleteRoom(roomId, roomName) {
    if (!confirm("'" + roomName + "' 채팅방을 삭제할까요?\n연관된 데이터가 DB에서 삭제됩니다.")) return;
    try {
      var res = await fetch('/api/rooms/' + roomId, { method: 'DELETE' });
      var data = await res.json();
      if (res.ok) {
        showFlash("'" + roomName + "' 채팅방이 삭제되었습니다.", 'success');
        setTimeout(function() { location.reload(); }, 800);
      } else {
        showFlash(data.detail || '삭제 실패', 'error');
      }
    } catch(e) { showFlash('삭제 중 오류가 발생했습니다.', 'error'); }
  }

  function onRoomCreated(evt) {
    if (evt.detail.successful) {
      document.getElementById('add-room-modal').classList.add('hidden');
      document.getElementById('create-room-form').reset();
      showFlash('채팅방이 생성되었습니다. ✅', 'success');
      setTimeout(function() { location.reload(); }, 900);
    } else {
      var msg = '채팅방 생성 실패';
      try { msg = JSON.parse(evt.detail.xhr.responseText).detail; } catch(e) {}
      showFlash(msg, 'error');
    }
  }

  document.getElementById('upload-form').addEventListener('htmx:afterRequest', function(evt) {
    var resultEl = document.getElementById('upload-result');
    if (evt.detail.successful) {
      var d = JSON.parse(evt.detail.xhr.responseText);
      resultEl.innerHTML = '<div class="bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 text-sm">' +
        '✅ <strong>' + d.room_name + '</strong> 업로드 완료 · ' +
        d.dates_processed + '일 처리 · 새 메시지 ' + d.new_messages + '개' +
        (d.invalidated_summaries > 0 ? ' · <span class="text-orange-500">요약 ' + d.invalidated_summaries + '일 갱신 필요</span>' : '') +
        ' <a href="/rooms/' + d.room_id + '" class="ml-2 underline font-semibold">보기 →</a></div>';
      evt.target.reset();
      setTimeout(function() { location.reload(); }, 1500);
    } else {
      var msg = '업로드 처리 실패';
      try { msg = JSON.parse(evt.detail.xhr.responseText).detail; } catch(e) {}
      resultEl.innerHTML = '<div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm">❌ ' + msg + '</div>';
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') document.getElementById('add-room-modal').classList.add('hidden');
  });
</script>
{% endblock %}
